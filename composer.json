{
  "name": "yeremi/route-mapper",
  "description": "A PHP library for mapping and resolving routes using attributes.",
  "license": "MIT",
  "type": "library",
  "keywords": [
    "attributes",
    "api",
    "normalizer",
    "route"
  ],
  "authors": [
    {
      "name": "yeremi",
      "email": "yeremiloli@yahoo.com"
    }
  ],
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.65.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Yeremi\\RouteMapper\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yeremi\\RouteMapper\\Test\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "cs-check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "cs-fix": "@php vendor/bin/php-cs-fixer fix",
    "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=512M",
    "test": "@php vendor/bin/phpunit"
  }
}